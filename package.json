{
  "name": "oss-design-tool",
  "version": "0.11.0-beta.12",
  "private": true,
  "description": "Orion Security Solutions — Enterprise Network, Physical Security & Infrastructure Design Tool",
  "scripts": {
    "verify": "node scripts/verify_app.js",
    "test": "node scripts/verify_app.js",
    "code:index": "node scripts/code_index.js summary",
    "code:lookup": "node scripts/code_index.js lookup",
    "code:refs": "node scripts/code_index.js refs",
    "code:audit": "node scripts/code_index.js audit",
    "catalog:audit": "node scripts/catalog_pipeline.js audit",
    "catalog:link": "node scripts/catalog_pipeline.js auto-link --apply",
    "catalog:validate": "node scripts/catalog_pipeline.js validate",
    "catalog:ingest": "node scripts/catalog_pipeline.js ingest",
    "css": "npx tailwindcss -i ./assets/css/tailwind-input.css -o ./assets/css/tailwind.min.css --minify",
    "bump:patch": "node scripts/bump_version.js --patch",
    "bump:minor": "node scripts/bump_version.js --minor",
    "bump:set": "node scripts/bump_version.js --set",
    "serve": "npx --yes serve -l 8080 ."
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
