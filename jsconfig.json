{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "."
  },
  "include": [
    "js/**/*.js",
    "data/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "Datasheets",
    "assets",
    "scratch",
    ".git"
  ]
}
