{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/login.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout?post_logout_redirect_uri=/login.html"
    },
    {
      "route": "/data/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/js/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/Datasheets/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/datasheets/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/assets/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/login.html"
    },
    "403": {
      "statusCode": 302,
      "redirect": "/login.html"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/data/*",
      "/js/*",
      "/Datasheets/*",
      "/datasheets/*",
      "/login.html",
      "/CHANGELOG.md",
      "*.{css,scss,js,png,gif,ico,jpg,svg,webp,json,pdf,md}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "frame-ancestors 'self' https://*.sharepoint.com https://*.office.com https://*.officeapps.live.com;"
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".pdf": "application/pdf",
    ".md": "text/markdown; charset=utf-8"
  }
}
